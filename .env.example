# Optional pilot access control. Use a secret manager in production.
REVIEW_API_KEY=replace-with-a-long-random-value
REVIEW_AUTH_USER=local-reviewer
REVIEW_REQUIRE_AUTH=true
# Optional JSON policy. Example grants one repository and one source-root prefix:
REVIEW_REPOSITORY_PERMISSIONS={"local-reviewer":{"repositories":{"automotive-ecu-demo":["automotive_ecu_demo/"]}}}

# Local service endpoints and workflow storage.
REVIEW_API_URL=http://localhost:8000/api/v1/review
OLLAMA_BASE_URL=http://localhost:11434
REVIEW_DATABASE=data/reviews.db
